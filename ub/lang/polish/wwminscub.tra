@657 = ~Byæ mo¿e Boo zmêczy³o mieszkanie w twoim plecaku i uciek³. Nie przysz³o ci nigdy na myœl, by go wyczyœciæ?~
@658 = ~Rozejrzyj siê uwa¿niej. Boo z pewnoœci¹ œpi gdziej w twojej zbroi.~
@659 = ~Jakiœ kot na pewno go zjad³. I bardzo dobrze.~
@660 = ~O-o, wygl¹da na to, ¿e ktoœ zabra³ ci Boo. Ktokolwiek to zrobi³, niech lepiej siê przyzna!~
@661 = ~<CHARNAME>! Czy nie mieliœmy rozejrzeæ siê w Dokach? Powiedzia³eœ, ¿e pomo¿esz mi odnaleŸæ ma³ego Boo! Nie widzê pomocy!~ ~<CHARNAME>! Czy nie mieliœmy rozejrzeæ siê w Dokach? Powiedzia³aœ, ¿e pomo¿esz mi odnaleŸæ ma³ego Boo! Nie widzê pomocy!~
@662 = ~Nie martw siê, Minsc. To wszysto jest czêœci¹ planu. Pokonamy z³o z zaskoczenia!~
@663 = ~Wci¹¿ CIÊ szukamy, Boo.~
@664 = ~Przestañ wci¹¿ gadaæ o tej futrzanej kulce!~
@665 = ~<CHARNAME>!! Wci¹¿ nie przeszukaliœmy ka¿dej ryby w Dokach!! Musimy siê tam natychmiast udaæ!~
@666 = ~Boo mo¿e byæ teraz w rêkach z³ych piratów, kiedy my tu rozmawiamy!! Mówi³eœ wczeœniej, ¿e go znajdziemy, ale w mojej kieszeni nadal nie ma Boo!!~ ~Boo mo¿e byæ teraz w rêkach z³ych piratów, kiedy my tu rozmawiamy!! Mówi³aœ wczeœniej, ¿e go znajdziemy, ale w mojej kieszeni nadal nie ma Boo!!~
@667 = ~Pójdziemy tam natychmiast.~
@668 = ~Jak do tej po prostu nie mieliœmy szczêœcia. Wytrzymaj trochê d³u¿ej.~
@669 = ~Zamknij jadaczkê. Nigdzie nie pójdziemy.~
@670 = ~Nie jesteœ przyjacielem, <CHARNAME>! Unosi siê od ciebie smród nie-znalezionego-chomiczego z³a! Wiedz, ¿e gdy ju¿ znajdê ma³ego Boo, wrócimy razem i skopiemy ci ty³ek i przywalimy ci solidn¹ dawk¹ cnoty!!~ ~Nie jesteœ przyjació³k¹, <CHARNAME>! Unosi siê od ciebie smród nie-znalezionego-chomiczego z³a! Wiedz, ¿e gdy ju¿ znajdê ma³ego Boo, wrócimy razem i skopiemy ci ty³ek i przywalimy ci solidn¹ dawk¹ cnoty!!~
@671 = ~Gdzie, ach gdzie mój ma³y Boo?

Zbyt d³ugo opóŸnialiœmy poszukiwania Boo, chomika Minsca, tak wiêc nasz ³owca opuœci³ nas twierdz¹c, ¿e sam znajdzie Boo. Mam nadziejê, ¿e przyjdzie nam jeszcze kiedyœ spotkaæ Minsca oraz jego chomika Boo.~
@672 = ~Musimy siê spieszyæ i przeszukaæ ka¿d¹ fontannê, <CHARNAME>. Boo jest w niebezpieczeñstwie! Albo pod wod¹.~
@673 = ~Ty! Minsc pamiêta ciê! Ogl¹da³eœ ma³ego Boo, ma³y ch³opcze!~
@674 = ~Ach, Boo, jak dobrze jest mieæ ciê z powrotem. Zaprawdê, przybra³eœ na wadze i czujê, ¿e mam ciê teraz wiêcej ni¿ kiedykolwiek!~
@675 = ~Skoñczy³eœ ju¿ z Boo? Mamy zadanie do wykonania, a twoje dziwne zainteresowania spowalniaj¹ dru¿ynê.~
@676 = ~Minsc, Ja... muszê siê do czegoœ przyznaæ.~
@677 = ~Dzieñ dobry, Boo! Dzieñ dobry, Booleci¹tka!~
@678 = ~Czekaj... dlaczego Boo ma Booleci¹tka? Boo, czy jest coœ, o czym mi nie powiedzia³eœ?!~
@679 = ~Nie, Boo to ch³opiec. Wiele razy mi o tym mówi³! Co znaczy... co znaczy, ¿e.. to nie jest Boo!!~
@680 = ~<CHARNAME>, powiedzia³eœ mi, ¿e to by³ Boo! Zdradzi³eœ Minsca? Twojego najbardziej wiernego przyjaciela? Dlaczego?~ ~<CHARNAME>, powiedzia³aœ mi, ¿e to by³ Boo! Zdradzi³aœ Minsca? Twojego najbardziej wiernego przyjaciela? Dlaczego?~
@681 = ~Tylko po to, by ujrzeæ teraz twój wyraz twarzy.~
@682 = ~Có¿ mogê rzec? Nudzi³o mi siê.~
@683 = ~Mia³em ju¿ doœæ twoich ryków i g³upoty. Pozbycie siê twojego chomika by³o pierwszym krokiem do pozbycia siê CIEBIE.~ ~Mia³am ju¿ doœæ twoich ryków i g³upoty. Pozbycie siê twojego chomika by³o pierwszym krokiem do pozbycia siê CIEBIE.~
@684 = ~Doœæ tych g³upich ¿artów! Czêsto zastanawia³em siê, który z nas jest mocniejszy. Wyci¹gnij broñ, Minsc! Zobaczymy, jak mocny jesteœ BEZ Boo!~ ~Doœæ tych g³upich ¿artów! Czêsto zastanawia³am siê, kto z nas jest mocniejszy. Wyci¹gnij broñ, Minsc! Zobaczymy, jak mocny jesteœ BEZ Boo!~
@685 = ~To by³ tylko ¿art.. niezbyt udany. Kupi³em zwyk³ego chomika u Smethy'ego. Jeœli ma to jeszcze jakieœ znaczenie, to przepraszam, Minscu.~ ~To by³ tylko ¿art.. niezbyt udany. Kupi³am zwyk³ego chomika u Smethy'ego. Jeœli jeszcze ma to jakieœ znaczenie, to przepraszam, Minscu.~
